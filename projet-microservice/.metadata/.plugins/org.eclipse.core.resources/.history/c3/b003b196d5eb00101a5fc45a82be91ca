spring:
  application:
    name: api-gateway

  cloud:
    gateway:

      # =========================
      # ROUTES
      # =========================
      routes:

        - id: surveillance-service
          uri: lb://SURVEILLANCE-SERVICE
          predicates:
            - Path=/api/surveillance/**

        - id: notification-service
          uri: lb://NOTIFICATION-SERVICE
          predicates:
            - Path=/api/notifications/**

        - id: maintenance-service
          uri: lb://MAINTENANCE-SERVICE
          predicates:
            - Path=/api/maintenance/**

      # =========================
      # CORS GLOBAL
      # =========================
      globalcors:
        corsConfigurations:
          '[/**]':
            allowedOrigins: "*"
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
            allowedHeaders: "*"

# =========================
# SERVER
# =========================
server:
  port: 8080

# =========================
# CONFIG CUSTOM
# =========================
config:
  message: "API Gateway - Surveillance Platform"

# =========================
# EUREKA
# =========================
eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:8761/eureka
  instance:
    prefer-ip-address: true

# =========================
# ACTUATOR
# =========================
management:
  endpoints:
    web:
      exposure:
        include: "*"
      base-path: /actuator
  endpoint:
    health:
      show-details: always
    gateway:
      enabled: true
  info:
    env:
      enabled: true
