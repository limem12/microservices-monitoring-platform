spring:
  application:
    name: gateway
  cloud:
    gateway:
      routes:
        - id: auth-service
          uri: lb://auth-service
          predicates:
            - Path=/api/auth/**
        - id: agriculteur-service
          uri: lb://agriculteur-service
          predicates:
            - Path=/api/agriculteurs/**
        - id: equipement-service
          uri: lb://equipement-service
          predicates:
            - Path=/api/equipements/**
        - id: supervision-service
          uri: lb://supervision-service
          predicates:
            - Path=/api/supervision/**
      globalcors:
        corsConfigurations:
          '[/**]':
            allowedOrigins: "*"
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
            allowedHeaders: "*"

server:
  port: 8888

config:
  message: "Gateway Service - Configuration locale"

eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:9095/eureka
  instance:
    prefer-ip-address: true

management:
  endpoints:
    web:
      exposure:
        include: "*"
      base-path: /actuator
  endpoint:
    health:
      show-details: always
    gateway:
      enabled: true
  info:
    env:
      enabled: true